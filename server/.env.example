# Smart Compiler Platform Environment Configuration

# Server Network Settings
PORT=5000
NODE_ENV=development

# JWT Secret for Session & User Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-for-production-2026

# Database Path (SQLite with WAL mode)
DB_PATH=./smart_compiler.db

# Execution Sandbox Limits
MAX_EXEC_TIME_MS=5000
MAX_OUTPUT_BYTES=65536

# AI Orchestration Provider
# Options: 'heuristic' (default offline static & diagnostic engine), 'groq', 'openrouter', 'gemini', 'ollama', 'openai'
AI_PROVIDER=heuristic

# API Key for External Provider (Leave blank when using built-in heuristic engine)
AI_API_KEY=

# Model Name (Configurable per provider)
# Groq: llama-3.3-70b-versatile
# OpenRouter: meta-llama/llama-3.3-70b-instruct
# Gemini: gemini-1.5-flash
AI_MODEL=llama-3.3-70b-versatile

# Optional Custom Endpoint (e.g. for local Ollama http://localhost:11434/v1/chat/completions)
AI_ENDPOINT=
